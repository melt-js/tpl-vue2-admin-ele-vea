# Package-local development settings. Public hosting bases come from the root env sync.
DEV_PORT=50010
PREVIEW_PORT=50020
# Use hosted components; set REMOTE_TARGET=local for provider development.

# Runtime defaults: localhost. Candidates contain complete paths; roots may be shared.
REMOTE_TARGET=local
COMPS_VUE2_LOCAL_ENTRY=http://localhost:20040
COMPS_VUE2_SFTP_ENTRY=${SFTP_PUBLIC_URL}/@melt-js/comps-vue2/hel_dist/hel-meta.json
COMPS_VUE2_GITHUB_ENTRY=${GITHUB_PUBLIC_URL}/comps-vue2/hel_dist/hel-meta.json
COMPS_VUE2_UNPKG_ENTRY=${UNPKG_PUBLIC_URL}/@melt-js/comps-vue2@2026.11.16/hel_dist/hel-meta.json
VUE_APP_COMPS_VUE2_HOST=${COMPS_VUE2_LOCAL_ENTRY}
COMPS_VUE2_ELE_LOCAL_ENTRY=http://localhost:20010
COMPS_VUE2_ELE_SFTP_ENTRY=${SFTP_PUBLIC_URL}/@melt-js/comps-vue2-ele/hel_dist/hel-meta.json
COMPS_VUE2_ELE_GITHUB_ENTRY=${GITHUB_PUBLIC_URL}/comps-vue2-ele/hel_dist/hel-meta.json
COMPS_VUE2_ELE_UNPKG_ENTRY=${UNPKG_PUBLIC_URL}/@melt-js/comps-vue2-ele@2026.11.16-1/hel_dist/hel-meta.json
VUE_APP_COMPS_VUE2_ELE_HOST=${COMPS_VUE2_ELE_LOCAL_ENTRY}
COMPS_VUE2_ELE_VEA_LOCAL_ENTRY=http://localhost:20011
COMPS_VUE2_ELE_VEA_SFTP_ENTRY=${SFTP_PUBLIC_URL}/@melt-js/comps-vue2-ele-vea/hel_dist/hel-meta.json
COMPS_VUE2_ELE_VEA_GITHUB_ENTRY=${GITHUB_PUBLIC_URL}/comps-vue2-ele-vea/hel_dist/hel-meta.json
COMPS_VUE2_ELE_VEA_UNPKG_ENTRY=${UNPKG_PUBLIC_URL}/@melt-js/comps-vue2-ele-vea@2026.11.17-1/hel_dist/hel-meta.json
VUE_APP_COMPS_VUE2_ELE_VEA_HOST=${COMPS_VUE2_ELE_VEA_LOCAL_ENTRY}