# just a flag
ENV = 'production'

# base api
VUE_APP_BASE_API = '/prod-api'

# 普通后台模板产物目录（vue-cli 输出 dist）；避免残留 hel_dist 被探测为产物
DEPLOY_OUTPUT_DIR=dist

# Production defaults: SFTP. Override REMOTE_TARGET or individual entries locally.
REMOTE_TARGET=sftp
VUE_APP_COMPS_VUE2_HOST=${COMPS_VUE2_SFTP_ENTRY}
VUE_APP_COMPS_VUE2_ELE_HOST=${COMPS_VUE2_ELE_SFTP_ENTRY}
VUE_APP_COMPS_VUE2_ELE_VEA_HOST=${COMPS_VUE2_ELE_VEA_SFTP_ENTRY}

