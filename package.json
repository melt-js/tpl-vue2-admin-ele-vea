{
  "name": "@melt-js/tpl-vue2-admin-ele-vea",
  "version": "2026.11.17-1",
  "description": "A vue admin template with Element UI & axios & iconfont & permission control & lint",
  "author": "Pan <panfree23@gmail.com>",
  "unpkg": "dist/index.html",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--require=./env.config.cjs --openssl-legacy-provider\" vue-cli-service serve",
    "build:prod": "cross-env NODE_OPTIONS=\"--require=./env.config.cjs --openssl-legacy-provider\" vue-cli-service build",
    "build:stage": "cross-env NODE_OPTIONS=\"--require=./env.config.cjs --openssl-legacy-provider\" vue-cli-service build --mode staging",
    "preview": "node build/index.js --preview",
    "publish:stage": "cross-env REMOTE_TARGET=unpkg pnpm run build && hel-publish-stage",
    "svgo": "svgo -f src/icons/svg --config=src/icons/svgo.config.js",
    "lint": "eslint --ext .js,.vue src",
    "test:unit": "cross-env NODE_OPTIONS=\"--require=./env.config.cjs --openssl-legacy-provider\" vue-cli-service test:unit",
    "test:ci": "pnpm run lint && pnpm run test:unit",
    "build": "cross-env NODE_OPTIONS=\"--require=./env.config.cjs --openssl-legacy-provider\" vue-cli-service build",
    "dev:local": "cross-env NODE_OPTIONS=\"--require=./env.config.cjs --openssl-legacy-provider\" REMOTE_TARGET=local vue-cli-service serve"
  },
  "dependencies": {
    "@melt-js/comps-vue2": "2026.11.17",
    "@melt-js/comps-vue2-ele": "2026.11.16-2",
    "@melt-js/libs-core": "2026.11.16-2",
    "axios": "1.21.0",
    "clipboard": "2.0.11",
    "core-js": "3.51.0",
    "element-ui": "2.15.14",
    "file-saver": "2.0.5",
    "hel-lib-proxy": "4.12.3",
    "hel-micro": "4.15.3",
    "js-cookie": "3.0.8",
    "jszip": "3.10.1",
    "normalize.css": "8.0.1",
    "nprogress": "0.2.0",
    "path-to-regexp": "3.3.0",
    "sortablejs": "1.15.7",
    "vue": "2.7.16",
    "vue-count-to": "1.0.13",
    "vue-router": "3.6.5",
    "vuex": "3.6.2"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "4.5.19",
    "@vue/cli-plugin-eslint": "4.5.19",
    "@vue/cli-plugin-unit-jest": "4.5.19",
    "@vue/cli-service": "4.5.19",
    "@vue/test-utils": "1.3.6",
    "autoprefixer": "9.8.8",
    "babel-eslint": "10.1.0",
    "babel-jest": "24.9.0",
    "babel-plugin-dynamic-import-node": "2.3.3",
    "body-parser": "1.20.9",
    "chalk": "2.4.2",
    "chokidar": "3.6.0",
    "connect": "3.7.0",
    "cross-env": "7.0.3",
    "eslint": "6.8.0",
    "eslint-plugin-vue": "6.2.2",
    "jest-environment-jsdom-fifteen": "1.0.2",
    "mockjs": "1.1.0",
    "runjs": "4.4.2",
    "sass": "1.107.1",
    "sass-loader": "8.0.2",
    "serve-static": "1.16.3",
    "svg-sprite-loader": "6.0.11",
    "svgo": "2.8.4",
    "vue-template-compiler": "2.7.16"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "engines": {
    "node": ">=8.9",
    "npm": ">= 3.0.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "config": {
    "remoteEntries": {
      "VUE_APP_COMPS_VUE2_HOST": {
        "local": "COMPS_VUE2_LOCAL_ENTRY",
        "sftp": "COMPS_VUE2_SFTP_ENTRY",
        "github": "COMPS_VUE2_GITHUB_ENTRY",
        "unpkg": "COMPS_VUE2_UNPKG_ENTRY"
      },
      "VUE_APP_COMPS_VUE2_ELE_HOST": {
        "local": "COMPS_VUE2_ELE_LOCAL_ENTRY",
        "sftp": "COMPS_VUE2_ELE_SFTP_ENTRY",
        "github": "COMPS_VUE2_ELE_GITHUB_ENTRY",
        "unpkg": "COMPS_VUE2_ELE_UNPKG_ENTRY"
      },
      "VUE_APP_COMPS_VUE2_ELE_VEA_HOST": {
        "local": "COMPS_VUE2_ELE_VEA_LOCAL_ENTRY",
        "sftp": "COMPS_VUE2_ELE_VEA_SFTP_ENTRY",
        "github": "COMPS_VUE2_ELE_VEA_GITHUB_ENTRY",
        "unpkg": "COMPS_VUE2_ELE_VEA_UNPKG_ENTRY"
      }
    }
  }
}
